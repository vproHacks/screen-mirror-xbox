--- third_party/UxPlay/lib/raop.c	2026-10-17 05:52:09.597974800 -0400
+++ src/airplay/raop.c	2026-10-17 14:42:24.167821200 -0400
@@ -899,3 +899,77 @@
     }
     return codec_string[codec];
 }
+
+/* Returns a malloc'ed, null-terminated copy of an HLS playlist collected from the client:
+ * path "/master.m3u8" gives the (adjusted) master playlist, any other path the media playlist
+ * listed under it, with YouTube's condensed URIs expanded. This is the content http_handler_hls
+ * serves on the local HLS channel; a player that cannot reach that channel over loopback (UWP)
+ * can fetch it directly with this call. Returns NULL if no HLS video is current or the path is
+ * unknown. */
+char *
+raop_get_hls_playlist(raop_t *raop, const char *path, int *len) {
+    assert(raop);
+    assert(path);
+    if (len) *len = 0;
+    if (raop->current_video < 0 || !raop->airplay_video[raop->current_video]) {
+        return NULL;
+    }
+    airplay_video_t *airplay_video = raop->airplay_video[raop->current_video];
+    char *data = NULL;
+    if (!strcmp(path, "/master.m3u8")) {
+        char *master_playlist = get_master_playlist(airplay_video);
+        if (master_playlist) {
+            data = strdup(master_playlist);
+        }
+    } else {
+        int chunks = 0;
+        float duration = 0.0f;
+        char *media_playlist = get_media_playlist(airplay_video, &chunks, &duration, path);
+        if (media_playlist) {
+            data = adjust_yt_condensed_playlist(media_playlist, chunks);
+        }
+    }
+    if (data && len) {
+        *len = (int) strlen(data);
+    }
+    return data;
+}
+
+/* Sends a video playback state event to the client over the reverse (PTTH) connection, as an Apple
+ * TV does: POST /event with a plist {category: video, sessionID, state}. state is "loading",
+ * "playing", "paused" or "stopped"; "stopped" tells the client that the current item has ended (the
+ * YouTube app then moves on, e.g. from an advertisement to the video). Returns 0 if it was sent. */
+int
+raop_send_video_event(raop_t *raop, const char *state) {
+    assert(raop);
+    assert(state);
+    if (raop->current_video < 0 || !raop->airplay_video[raop->current_video]) {
+        return -1;
+    }
+    const char *session_id = get_apple_session_id(raop->airplay_video[raop->current_video]);
+    int socket_fd = httpd_get_connection_socket_by_type(raop->httpd, CONNECTION_TYPE_PTTH, 1);
+    if (!session_id || socket_fd <= 0) {
+        return -1;
+    }
+    plist_t root = plist_new_dict();
+    plist_dict_set_item(root, "category", plist_new_string("video"));
+    plist_dict_set_item(root, "sessionID", plist_new_uint(1));  /* as in the FCUP requests */
+    plist_dict_set_item(root, "state", plist_new_string(state));
+    char *plist_xml = NULL;
+    uint32_t xml_len = 0;
+    plist_to_xml(root, &plist_xml, &xml_len);
+    plist_free(root);
+
+    http_response_t *request = http_response_create();
+    http_response_reverse_request_init(request, "POST", "/event", "HTTP/1.1");
+    http_response_add_header(request, "X-Apple-Session-ID", session_id);
+    http_response_add_header(request, "Content-Type", "text/x-apple-plist+xml");
+    http_response_finish(request, plist_xml, (int) xml_len);
+    plist_mem_free(plist_xml);
+    int request_len = 0;
+    const char *data = http_response_get_data(request, &request_len);
+    int sent = send(socket_fd, data, request_len, 0);
+    http_response_destroy(request);
+    logger_log(raop->logger, LOGGER_INFO, "video event \"%s\" sent to the client (%d bytes)", state, sent);
+    return sent == request_len ? 0 : -1;
+}
