<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- Identity reserved in Partner Center (Product identity page) -->
  <Identity Name="vpro8725.ScreenMirrorServer" Publisher="CN=D10B77AE-54C4-46E9-A4FE-56E07672A94E" Version="1.1.10.0" />

  <mp:PhoneIdentity PhoneProductId="d46abcfd-9c2d-49fa-9ebf-60d1a7d69654" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Screen Mirror Server</DisplayName>
    <PublisherDisplayName>vpro8725</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="AirServerXbox.App">
      <uap:VisualElements
        DisplayName="Screen Mirror Server"
        Description="Receive screen mirroring, videos and music from an iPhone or iPad on the same network."
        BackgroundColor="#101218"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Screen Mirror" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#101218" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
